+class _ChunkPrefetch:
+    """One chunk request in flight on a worker thread, and the timing that decides when to send it."""
+
+    def __init__(self) -> None:
+        self._executor = ThreadPoolExecutor(max_workers=1)
+        self._future: Future | None = None
+        self._obs_step: torch.Tensor | None = None
+        self._latency_s = 0.0
+        self._step_s = 0.0
+        self._last_tick: float | None = None
+
+    @property
+    def pending(self) -> bool:
+        return self._future is not None
+
+    def lead(self, chunk_length: int) -> int:
+        """Steps before the end of the chunk at which the next request goes out."""
+        if self._step_s <= 0.0:
+            return 0
+        return min(chunk_length - 1, math.ceil(self._latency_s / self._step_s))
+
+    def submit(self, request, obs_step: torch.Tensor | None) -> None:
+        sent = time.monotonic()
+
+        def run():
+            chunk = request()
+            self._latency_s = 0.8 * self._latency_s + 0.2 * (time.monotonic() - sent) if self._latency_s else (
+                time.monotonic() - sent)
+            return chunk
+
+        self._obs_step = None if obs_step is None else obs_step.clone()
+        self._future = self._executor.submit(run)
+
+    def take(self) -> tuple[torch.Tensor | None, torch.Tensor]:
+        chunk = self._future.result()
+        obs_step, self._future, self._obs_step = self._obs_step, None, None
+        return obs_step, chunk
+
+    def tick(self) -> None:
+        now = time.monotonic()
+        if self._last_tick is not None:
+            dt = now - self._last_tick
+            self._step_s = 0.8 * self._step_s + 0.2 * dt if self._step_s else dt
+        self._last_tick = now
+
+    def cancel(self) -> None:
+        """Drop the request in flight: wait for it and discard its result, or its error."""
+        if self._future is not None:
+            try:
+                self._future.result()
+            except Exception:
+                pass
+        self._future = self._obs_step = None
+
+    def close(self) -> None:
+        self.cancel()
+        self._executor.shutdown(wait=True)
