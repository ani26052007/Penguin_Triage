# Environment for the GPU runbook (run_order.md, "Environment"). Copy it outside the repo, edit the paths,
# then `source` it in every shell on the GPU box. It holds no secrets: export HF_TOKEN yourself, in your
# own shell, only if the Hugging Face repos turn out to be gated. Never write a token into this file.
export ARENA_ROOT="$HOME/Penguin_Triage/external/IsaacLab-Arena"   # the IsaacLab-Arena checkout
export VLA_VENV="$HOME/venvs/vla-isaac"                             # created by R0_setup.sh
export VLA_BACKEND_CONFIG="$HOME/vla-isaac-backend.yaml"            # written once by R0_setup.sh
export MODELS_DIR="/data/models/pilot"                              # R1 puts the checkpoint in $MODELS_DIR/ckpt
export DATA_DIR="/data/datasets"                                    # R1b datasets; IsaacBackend runs and patch store
export OMNI_KIT_ACCEPT_EULA=YES                                     # you accept the Omniverse / Isaac Sim EULA
export ACCEPT_EULA=Y
export RUN_TS="$(date -u +%Y%m%dT%H%M%SZ)"                          # one measurements/<RUN_TS>/ per session
export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json     # needs libnvidia-gl-<driver major>[-server]; Isaac Sim crashes without it
# Optional:
# To pin RUN_TS across shells, write it once (date -u +%Y%m%dT%H%M%SZ > ~/.vla_run_ts) and use:
# export RUN_TS="$(cat ~/.vla_run_ts)"
# export GR00T_HOST=127.0.0.1 GR00T_PORT=5555                       # the stock R2 server
# export MEASUREMENTS_DIR="$HOME/Penguin_Triage/measurements"
# export VLA_RUNBOOK_CONFIG=".../vla-isaac/config/runbook_<task>.yaml"   # another pilot (e.g. DROID)
